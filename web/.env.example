# Copiar a .env.local para desarrollo. Vite solo expone las variables VITE_*.

# De donde cuelga la API.
#
# Vacio (o sin la variable) = mismo origen: en desarrollo el proxy de Vite manda
# /api al backend en el 3000, y en produccion serviria para una API en el mismo
# dominio que la pagina.
#
# Si el backend vive aparte -por ejemplo en Render- aqui va su origen, sin barra
# final, y hay que compilar con esta variable puesta porque Vite la incrusta en el
# bundle; cambiarla despues no sirve de nada sin volver a compilar:
#
#   VITE_API_URL=https://inventario-ccsf2.onrender.com
#
# Ese mismo origen de la pagina tiene que estar en CORS_ORIGINS del backend, y el
# backend tiene que arrancar con COOKIE_SAMESITE=none.
VITE_API_URL=
