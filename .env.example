# Copiar a .env y ajustar. El .env NO se sube al repositorio.

NODE_ENV=development
PORT=3000
TZ=America/Guatemala

# Base de datos. El puerto 5433 es el que expone docker-compose.yml en el host.
DATABASE_URL="postgresql://inventario:inventario_dev@localhost:5433/inventario?schema=public"

# Secreto de sesion (Fase 3). Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambiar-esto-por-48-bytes-aleatorios-en-hex-minimo-32-caracteres"

# Base para construir las URL absolutas de las fotos (ver plan-backend.md seccion 9).
# Las fotos son archivos estaticos que sirve el FRONTEND desde /uniformes/, asi que
# esto apunta al sitio, no al backend:
#   desarrollo  -> http://localhost:5173  (el servidor de Vite)
#   produccion  -> https://inventario.ccsf2.edu.gt
MEDIA_BASE_URL="http://localhost:5173"

# Origenes permitidos por CORS, separados por coma. Son los origenes EXACTOS del
# frontend (esquema + dominio, sin barra final):
#   desarrollo  -> http://localhost:5173
#   produccion  -> https://inventario.ccsf2.edu.gt
CORS_ORIGINS="http://localhost:5173"

# Como se marca la cookie de sesion.
#   lax   -> frontend y API en el mismo dominio
#   none  -> en dominios distintos (pagina en el hosting del colegio, API en Render).
#            Obliga a HTTPS en los dos lados; con lax el navegador no manda la
#            cookie y todo responde 401.
COOKIE_SAMESITE=lax

# Contrasena que recibe el usuario admin al correr el seed (solo desarrollo).
SEED_ADMIN_PASSWORD="dev-admin-cambiar"
